# ── LLM Provider ──────────────────────────────────────────────────────────────
# GitHub Models was RETIRED on 2026-07-30 (404/410). Use Azure OpenAI / Foundry.

PROVIDER=azure

# Azure OpenAI (recommended — ABI corporate / RECT)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Legacy — no longer works (kept for reference only)
# GITHUB_TOKEN=your_github_token_here
# GITHUB_MODEL=gpt-4o

# ── V4: Microsoft 365 Copilot Chat API (MSAL in browser) ─────────────────────
# Entra app registration (SPA) — redirect URI http://localhost:3000/v4
AZURE_CLIENT_ID=your_entra_app_client_id
AZURE_TENANT_ID=organizations
# AZURE_REDIRECT_URI=http://localhost:3000/v4
# COPILOT_TIMEZONE=America/Sao_Paulo

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000

# V4 action log tasks spreadsheet (edit in Excel; server reloads on file change)
# ACTION_LOG_TASKS_XLSX=docs/V4_Action_Log_Tasks.xlsx

# ── V4.1: shared server-side provider (no Entra login for testers) ────────────
# Choose one: azure | openai | compatible
V41_PROVIDER=azure
# Azure reuses AZURE_OPENAI_* above.
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-4o
# For an OpenAI-compatible provider:
# V41_API_KEY=...
# V41_BASE_URL=https://provider.example/v1
# V41_MODEL=gpt-4o
